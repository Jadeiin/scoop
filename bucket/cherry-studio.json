            "hash": "sha512:e7b3498bb80ec06e566acf626e666c5f5d73d009e5a37962713000cc52f2331335960cfdbf59dcab1b59713954924bac653260d7dd5b78b7403a1e0831354b44",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\" -Recurse"
            ]
        },
        "arm64": {
            "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v2.0.0/Cherry-Studio-2.0.0-arm64-setup.exe#/dl.7z",
            "hash": "sha512:479b9651baafb09c0ff9394cf84a9dfa880f605475614281d84eb46822046254ee1f85859b394d134c0a542a7e89f60daad509d0f59fac7adfffc16794f0b4d5",
