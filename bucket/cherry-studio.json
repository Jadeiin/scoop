    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v2.0.9/Cherry-Studio-2.0.9-x64-setup.exe#/dl.7z",
            "hash": "sha512:88ed9382838d37eccccd0c252deb714b0e83b8f6d9821b2c621a49168c9c057db6c81b9c472edf795f57f0e207cfe23f854b9293f28752d66a87c8d258f6bcf6",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\" -Recurse"
            ]
        },
        "arm64": {
            "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v2.0.9/Cherry-Studio-2.0.9-arm64-setup.exe#/dl.7z",
            "hash": "sha512:6b429cf445aae2189dc145b10da8c0c00e9e0bd952abb6ecf390ed58a4bae3ed20533d5dcf3b9b4ed7263fec85c014dd5c19b046184c83d8e73a1c0d53acaf6b",
